# ha.py settings. Copy to ha.toml (next to ha.py) and edit. Every key is optional.

# Time zone for printed times and for times you type. Empty = this computer's local zone.
timezone = ""

# Results bigger than this many bytes of JSON go to out/ and only a summary is printed.
big_output_bytes = 4000

# Default row cap; --all shows everything.
max_rows = 50

# Any key whose name contains one of these words is printed as «redacted».
redact_keys = ["password", "token", "access_token", "refresh_token", "api_key", "encryption_key", "secret"]

# Dashboards ha.py refuses to save, e.g. ones generated by another tool. --unprotect overrides.
protected_dashboards = []

# Extra attributes `ha.py state` shows per domain.
[fields]
media_player = ["media_title"]
climate = ["current_temperature", "temperature", "hvac_action"]
light = ["brightness"]
